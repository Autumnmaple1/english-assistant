<Application x:Class="ScreenEnglish.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:Microsoft.UI.Xaml.Controls">
 <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <controls:XamlControlsResources/>
 </ResourceDictionary.MergedDictionaries>
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Light">
    <SolidColorBrush x:Key="CanvasBrush" Color="#FAFAF9"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#F1F1EF"/>
    <SolidColorBrush x:Key="CardBrush" Color="#F0F0EE"/>
    <SolidColorBrush x:Key="LineBrush" Color="#DEDEDB"/>
    <SolidColorBrush x:Key="InkBrush" Color="#252525"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#747471"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E8E8E5"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#292929"/>
    <SolidColorBrush x:Key="PrimaryInkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#DEDEDB"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#BBBBB8"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#777774"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#454545"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#555555"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#454545"/>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#555555"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="Default">
    <SolidColorBrush x:Key="CanvasBrush" Color="#202020"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#191919"/>
    <SolidColorBrush x:Key="CardBrush" Color="#292929"/>
    <SolidColorBrush x:Key="LineBrush" Color="#383838"/>
    <SolidColorBrush x:Key="InkBrush" Color="#E7E7E5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#969694"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#333333"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#E2E2DF"/>
    <SolidColorBrush x:Key="PrimaryInkBrush" Color="#202020"/>
    <SolidColorBrush x:Key="TextControlBackground" Color="#252525"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#292929"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#252525"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#929292"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B8B8B5"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#CDCDCA"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#C4C4C0"/>
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#B8B8B5"/>
   </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="QuietButton" TargetType="Button">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="MinWidth" Value="0"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="Padding" Value="9,5"/>
   <Setter Property="CornerRadius" Value="5"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{ThemeResource InkBrush}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
      <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
       <VisualState x:Name="Normal"/>
       <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Chrome.Background" Value="{ThemeResource HoverBrush}"/></VisualState.Setters></VisualState>
       <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.65"/></VisualState.Setters></VisualState>
       <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Chrome.Opacity" Value="0.35"/></VisualState.Setters></VisualState>
      </VisualStateGroup></VisualStateManager.VisualStateGroups>
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
     </Border>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Background" Value="{ThemeResource PrimaryBrush}"/>
   <Setter Property="Foreground" Value="{ThemeResource PrimaryInkBrush}"/>
   <Setter Property="Padding" Value="14,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="PrimaryChrome" Background="{TemplateBinding Background}" CornerRadius="5">
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="PrimaryChrome.Opacity" Value="0.84"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="PrimaryChrome.Opacity" Value="0.65"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="PrimaryChrome.Opacity" Value="0.35"/></VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,6"/><Setter Property="CornerRadius" Value="5"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,6"/><Setter Property="CornerRadius" Value="5"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ComboBox"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="9,5"/><Setter Property="CornerRadius" Value="5"/></Style>
  <Style TargetType="NumberBox"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="30"/><Setter Property="CornerRadius" Value="5"/></Style>
  <Style TargetType="CheckBox"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>
